    },
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{file:/home/stark/.config/opencode/tokenrouter-api-key}"
      },
      "models": {
        "z-ai/glm-4.5-air": {
          "name": "z-ai/glm-4.5-air"
        },
        "z-ai/glm-4.6": {
          "name": "z-ai/glm-4.6"
        },
        "z-ai/glm-4.6v": {
          "name": "z-ai/glm-4.6v"
        },
        "z-ai/glm-4.7": {
          "name": "z-ai/glm-4.7"
        },
        "z-ai/glm-5": {
          "name": "z-ai/glm-5"
        },
        "z-ai/glm-5-turbo": {
          "name": "z-ai/glm-5-turbo"
        },
        "z-ai/glm-5.1": {
          "name": "z-ai/glm-5.1"
        },
        "z-ai/glm-5.2": {
          "name": "z-ai/glm-5.2"
        },
        "z-ai/glm-5.3": {
          "name": "z-ai/glm-5.3"
        },
        "z-ai/glm-5.3-flash": {
          "name": "z-ai/glm-5.3-flash"
        },
        "z-ai/glm-5.3-free": {
          "name": "z-ai/glm-5.3-free"
        }
      }
    },
    "ds-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek Free (Web Chat)",
      "options": {
        "baseURL": "http://127.0.0.1:9655/v1",
        "apiKey": "unused"
      },
      "models": {
        "deepseek-chat": {
          "name": "deepseek-chat"
        },
        "deepseek-expert": {
          "name": "deepseek-expert"
        },
        "deepseek-reasoner": {
          "name": "deepseek-reasoner"
        },
        "deepseek-chat-search": {
          "name": "deepseek-chat-search"
        }
      }
    },
    "atria": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atria",
      "options": {
        "baseURL": "https://api.atria-asi.ai/v1",
        "apiKey": "{file:/home/stark/.config/opencode/atria-api-key}"
      },
      "models": {
        "Atria-Dawn-Preview": {
          "name": "Atria Dawn Preview",
          "limit": {
            "context": 256000,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "attachment": false,
          "temperature": true,
          "reasoning": false
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "ssh-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ssh-mcp"
      ],
      "enabled": true
    },
    "octocode": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "octocode-mcp@latest"
      ],
      "enabled": true,
      // cold `npx` install + tool listing needs way more than the 5s default
      "timeout": 120000,
      "environment": {
        // local code-search tools (offline, no token needed)
        "ENABLE_LOCAL": "true"
        // GitHub tools need a token. Add here once you have one:
        // "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs",
      "enabled": true
    }
  }
}
