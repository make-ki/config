{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "session_rename": "none"
  },
  "plugin": [
    [
      "@renjfk/opencode-voice",
      {
        "endpoint": "https://api.b.ai/v1",
        "model": "qwen3.8-flash",
        "apiKeyEnv": "BAI_API_KEY",
        "trimSilence": true
      }
    ],
    [
      "@semirhuduti/opencode-tts-voice",
      {
        "voice": "af_heart",
        "speed": 1.05,
        "speechBlocks": ["message", "idle"],
        "speakResponses": true,
        "speakQuestions": true,
        "speakSubagentResponses": false,
        "speakOnIdle": false,
        "audioPlayer": "mpv",
        "cacheDir": "/home/stark/.cache/opencode-kokoro",
        "shortcuts": {
          "history": "f5",
          "pause": "f6",
          "skipLatest": "f7",
          "toggle": "f8"
        }
      }
    ]
  ]
}
