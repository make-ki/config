{
    "layer": "top",
    "position": "top",
    "height": 24,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "battery", "pulseaudio", "custom/equalizer", "tray"],
    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": true
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  Connected",
        "format-disconnected": "⚠  Disconnected"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/equalizer": {
        "exec": "~/.config/waybar/equalizer.sh",
        "interval": 10,
        "signal": 2,
        "on-click": "~/.config/waybar/equalizer.sh toggle",
        "on-click-right": "easyeffects"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": true
    },
    "clock": {
        "format": "{:%H:%M}"
    }
}
